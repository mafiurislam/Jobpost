<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|\.git">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block direct web downloads of SQLite databases
    <FilesMatch "\.(sqlite|sqlite3|db)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rewrite all traffic into the /public directory transparently
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
